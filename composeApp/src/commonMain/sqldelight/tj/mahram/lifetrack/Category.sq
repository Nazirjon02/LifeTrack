CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    icon TEXT NOT NULL,
    color TEXT NOT NULL,
    isCustom INTEGER NOT NULL DEFAULT 0
);

insertCategory:
INSERT INTO category VALUES (?, ?, ?, ?, ?, ?);

insertCategoryOrIgnore:
INSERT OR IGNORE INTO category VALUES (?, ?, ?, ?, ?, ?);

selectAllCategories:
SELECT * FROM category ORDER BY isCustom ASC, name ASC;

selectCategoriesByType:
SELECT * FROM category WHERE type = ? ORDER BY isCustom ASC, name ASC;

selectCategoryById:
SELECT * FROM category WHERE id = ?;

updateCategory:
UPDATE category SET name = ?, icon = ?, color = ? WHERE id = ?;

deleteCategory:
DELETE FROM category WHERE id = ?;

countCategories:
SELECT COUNT(*) FROM category;
