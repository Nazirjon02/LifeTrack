-- Migration 5 → 6: the "Problems" tracker (replaces the removed Habits feature).
-- A problem carries solutions, an action plan, priority, status, category,
-- progress and an optional target date used by the calendar. Every meaningful
-- change is appended to problem_history so the user keeps an audit trail.
CREATE TABLE IF NOT EXISTS problem (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    solutions TEXT,
    actionPlan TEXT,
    priority TEXT NOT NULL DEFAULT 'MEDIUM',
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    category TEXT NOT NULL DEFAULT '',
    progress INTEGER NOT NULL DEFAULT 0,
    color TEXT NOT NULL DEFAULT '#7C3AED',
    dueDate INTEGER,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    resolvedAt INTEGER
);

CREATE TABLE IF NOT EXISTS problem_history (
    id TEXT NOT NULL PRIMARY KEY,
    problemId TEXT NOT NULL,
    message TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);
